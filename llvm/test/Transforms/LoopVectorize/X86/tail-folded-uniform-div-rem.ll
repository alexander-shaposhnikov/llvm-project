; guard. For n = 4 the last vector iteration has only lane 0 active. Tail masks
; are prefixes, so an invariant div/rem address can still be computed once.
define void @tail_uniform_ptr(ptr noalias %dst, ptr noalias %src, i32 %divisor, i64 %n) {
; CHECK-LABEL: define void @tail_uniform_ptr(
