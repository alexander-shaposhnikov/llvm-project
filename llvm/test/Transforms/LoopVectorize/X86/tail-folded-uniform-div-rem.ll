entry:
  %empty = icmp ule i64 %n, 1
  br i1 %empty, label %exit, label %loop

loop:
  %iv = phi i64 [ 1, %entry ], [ %next, %loop ]
  %index = urem i32 10, %divisor
  %wide = zext i32 %index to i64
  %ptr = getelementptr i32, ptr %src, i64 %wide
  %value = load i32, ptr %ptr, align 4
  %out = getelementptr i32, ptr %dst, i64 %iv
  store i32 %value, ptr %out, align 4
  %next = add nuw i64 %iv, 1
  %done = icmp eq i64 %next, %n
