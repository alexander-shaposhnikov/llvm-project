; CHECK-NEXT:    call void @llvm.masked.store.v2i32.p0(<2 x i32> [[BROADCAST_SPLAT3]], ptr align 4 [[TMP8]], <2 x i1> [[TMP5]])
; CHECK-NEXT:    [[INDEX_NEXT]] = add i64 [[INDEX1]], 2
; CHECK-NEXT:    [[VEC_IND_NEXT]] = add nuw <2 x i64> [[VEC_IND]], splat (i64 2)
