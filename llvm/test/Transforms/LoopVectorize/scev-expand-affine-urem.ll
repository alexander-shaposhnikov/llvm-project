; Test expanding SCEVs that contain a urem which is scaled, truncated and/or
; part of a larger sum. The urem should be expanded as such or reuse an
; existing urem, instead of being expanded as udiv + mul + sub.

; The pointer difference checked by the runtime check of the inner loop is
; (p1 - p2) + 256 * (outer.iv % grid_x), which should reuse %rem.
define void @runtime_memcheck_reuses_outer_urem(ptr %p1, ptr %p2, i64 %start, i64 %end, i64 range(i64 1, 2147483648) %grid_x) {
; CHECK-LABEL: define void @runtime_memcheck_reuses_outer_urem(
; CHECK-SAME: ptr [[P1:%.*]], ptr [[P2:%.*]], i64 [[START:%.*]], i64 [[END:%.*]], i64 range(i64 1, 2147483648) [[GRID_X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[P24:%.*]] = ptrtoaddr ptr [[P2]] to i64
; CHECK-NEXT:    [[P13:%.*]] = ptrtoaddr ptr [[P1]] to i64
; CHECK-NEXT:    [[TMP0:%.*]] = sub i64 [[P13]], [[P24]]
; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
; CHECK:       [[OUTER_HEADER]]:
; CHECK-NEXT:    [[OUTER_IV:%.*]] = phi i64 [ [[START]], %[[ENTRY]] ], [ [[OUTER_IV_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    [[REM:%.*]] = urem i64 [[OUTER_IV]], [[GRID_X]]
; CHECK-NEXT:    [[TILE_BASE:%.*]] = shl nuw nsw i64 [[REM]], 6
; CHECK-NEXT:    [[DST_BASE:%.*]] = getelementptr i32, ptr [[P1]], i64 [[TILE_BASE]]
; CHECK-NEXT:    br label %[[VECTOR_MEMCHECK:.*]]
; CHECK:       [[VECTOR_MEMCHECK]]:
; CHECK-NEXT:    [[TMP1:%.*]] = shl i64 [[REM]], 8
; CHECK-NEXT:    [[TMP2:%.*]] = add i64 [[TMP0]], [[TMP1]]
; CHECK-NEXT:    [[TMP3:%.*]] = sub i64 [[TMP2]], 1
; CHECK-NEXT:    [[DIFF_CHECK:%.*]] = icmp ult i64 [[TMP3]], 15
; CHECK-NEXT:    br i1 [[DIFF_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[TMP4:%.*]] = getelementptr i32, ptr [[P2]], i64 [[INDEX]]
; CHECK-NEXT:    [[WIDE_LOAD:%.*]] = load <4 x i32>, ptr [[TMP4]], align 4
; CHECK-NEXT:    [[TMP5:%.*]] = getelementptr i32, ptr [[DST_BASE]], i64 [[INDEX]]
; CHECK-NEXT:    store <4 x i32> [[WIDE_LOAD]], ptr [[TMP5]], align 4
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
; CHECK-NEXT:    [[TMP6:%.*]] = icmp eq i64 [[INDEX_NEXT]], 64
; CHECK-NEXT:    br i1 [[TMP6]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP0:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    br label %[[OUTER_LATCH]]
; CHECK:       [[SCALAR_PH]]:
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[SCALAR_PH]] ], [ [[IV_NEXT:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[SRC_GEP:%.*]] = getelementptr i32, ptr [[P2]], i64 [[IV]]
; CHECK-NEXT:    [[VAL:%.*]] = load i32, ptr [[SRC_GEP]], align 4
; CHECK-NEXT:    [[DST_GEP:%.*]] = getelementptr i32, ptr [[DST_BASE]], i64 [[IV]]
; CHECK-NEXT:    store i32 [[VAL]], ptr [[DST_GEP]], align 4
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[INNER_EC:%.*]] = icmp eq i64 [[IV_NEXT]], 64
; CHECK-NEXT:    br i1 [[INNER_EC]], label %[[OUTER_LATCH]], label %[[INNER]], !llvm.loop [[LOOP3:![0-9]+]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[OUTER_IV_NEXT]] = add nsw i64 [[OUTER_IV]], 1
; CHECK-NEXT:    [[OUTER_EC:%.*]] = icmp eq i64 [[OUTER_IV_NEXT]], [[END]]
; CHECK-NEXT:    br i1 [[OUTER_EC]], label %[[EXIT:.*]], label %[[OUTER_HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %outer.header

outer.header:
  %outer.iv = phi i64 [ %start, %entry ], [ %outer.iv.next, %outer.latch ]
  %rem = urem i64 %outer.iv, %grid_x
  %tile.base = shl nuw nsw i64 %rem, 6
  %dst.base = getelementptr i32, ptr %p1, i64 %tile.base
  br label %inner

inner:
  %iv = phi i64 [ 0, %outer.header ], [ %iv.next, %inner ]
  %src.gep = getelementptr i32, ptr %p2, i64 %iv
  %val = load i32, ptr %src.gep, align 4
  %dst.gep = getelementptr i32, ptr %dst.base, i64 %iv
  store i32 %val, ptr %dst.gep, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %inner.ec = icmp eq i64 %iv.next, 64
  br i1 %inner.ec, label %outer.latch, label %inner

outer.latch:
  %outer.iv.next = add nsw i64 %outer.iv, 1
  %outer.ec = icmp eq i64 %outer.iv.next, %end
  br i1 %outer.ec, label %exit, label %outer.header

exit:
  ret void
}

