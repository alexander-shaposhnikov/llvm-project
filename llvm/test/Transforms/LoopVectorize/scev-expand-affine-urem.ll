entry:
  %rem = urem i64 %x, %y
  %start = shl nuw nsw i64 %rem, 2
  %guard = icmp ult i64 %start, %z
  br i1 %guard, label %loop, label %exit

loop:
  %iv = phi i64 [ %start, %entry ], [ %iv.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %dst, i64 %iv
